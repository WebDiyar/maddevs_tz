# Базовый URL API. По умолчанию — встроенный mock (/api). Для реального бэка: https://api.example.com
NEXT_PUBLIC_API_BASE_URL=/api
# Задержка mock-ответов, мс (видно состояния загрузки/отправки)
MOCK_LATENCY_MS=400
# Доля POST, на которые mock отвечает 409 «слот занял другой»: 0.2 или 20 (%). 0 — выкл
MOCK_CONFLICT_RATE=0.2
