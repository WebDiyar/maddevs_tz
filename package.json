{
  "name": "maddevs",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "lint:fsd": "steiger src",
    "lint:fsd:fix": "steiger src --fix",
    "lint:tw": "node scripts/tw-check.mjs",
    "lint:tw:fix": "node scripts/tw-check.mjs --fix",
    "fsd": "node scripts/fsd-check.mjs",
    "fsd:ci": "node scripts/fsd-check.mjs --json",
    "lint:all": "npm run lint && npm run typecheck && npm run lint:fsd && npm run lint:tw && npm run fsd",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.9.2",
    "@tanstack/react-query": "^5.104.5",
    "axios": "^1.20.0",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.0",
    "date-fns": "^4.4.0",
    "lucide-react": "^1.61.0",
    "next": "16.4.2",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.8.1",
    "react": "19.3.0",
    "react-day-picker": "^10.0.2",
    "react-dom": "19.3.0",
    "react-hook-form": "^7.90.0",
    "shadcn": "^4.22.1",
    "sonner": "^2.0.8",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.7",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@feature-sliced/steiger-plugin": "^0.7.0",
